---
interface Props {
  infoSeccion: any;
  ui: any;
}
const { infoSeccion, ui } = Astro.props;
---

<div class="flex flex-wrap gap-4">
  {
    infoSeccion.map(({ title, authors, description, link, codigo }: any) => (
      <div
        title={description}
        class="block text-balance max-w-sm p-5 bg-[var(--dis-superficie)] border border-[var(--dis-borde)] transition hover:opacity-90"
        style="border-radius: var(--dis-radio); box-shadow: var(--dis-sombra);"
      >
        <h7 class="mb-2 text-lg font-bold tracking-tight text-[var(--dis-texto)]">
          {title}
        </h7>
        <p class="mb-2 mt-2 font-normal text-base text-[var(--dis-enlace)]">
          <a href={link} target="_blank">
            {codigo}
          </a>
        </p>

        <h7 class="mb-2 text-base font-bold tracking-tight text-[var(--dis-texto)]">
          {ui.publicaciones_autores}
        </h7>
        <p class="font-normal  text-base text-[var(--dis-texto-suave)]">
          {authors}
        </p>
      </div>
    ))
  }
</div>
