---
import ExperienceItem from "@/components/otros/TimeHistItem.astro";
interface Props {
  infoSeccion: any;
  opciones?: Record<string, boolean>;
}
const { infoSeccion, opciones = {} } = Astro.props;
const { mostrarValoracion = true } = opciones;
---

<ol class="relative mt-16">
  {
    infoSeccion.map((grados: any) => (
      <li class="">
        <ExperienceItem
          title={grados.title}
          company={grados.institution}
          appreciation={mostrarValoracion ? grados.appreciation : undefined}
        >
          <time class="p-0 m-0 md:col-span-3 text-right text-sm text-[var(--dis-texto-suave)]">
            {grados.date}
          </time>
        </ExperienceItem>
      </li>
    ))
  }
</ol>
