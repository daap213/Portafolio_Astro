---
import DropdownText from "@/components/otros/DropdownText.astro";
interface Props {
  infoSeccion: any;
  opciones?: Record<string, boolean>;
}
const { infoSeccion, opciones = {} } = Astro.props;
const { mostrarRelacionadas = true } = opciones;
---

<ol class="relative mt-16">
  {
    infoSeccion.map((habilidad: any) => (
      <li class="">
        <DropdownText titulo={habilidad.name}>
          <ul class="border border-[var(--dis-borde)] rounded overflow-hidden shadow-md">
            {habilidad.skills.map((activity: any) => (
              <li class="w-full px-4 py-2 border-b text-justify hover:bg-sky-100 hover:text-gray-900 border-gray-300 dark:border-gray-200 last:border-none transition-all duration-300 ease-in-out">
                {activity}
              </li>
            ))}
          </ul>
          {mostrarRelacionadas && habilidad.related?.length > 0 && (
            <ul class="border border-[var(--dis-acento)] rounded overflow-hidden shadow-md">
              {habilidad.related.map((activity: any) => (
                <li class="w-full px-4 py-2 border-b text-justify hover:bg-[var(--dis-superficie-suave)] border-[var(--dis-borde)] last:border-none transition-all duration-300 ease-in-out">
                  {activity}
                </li>
              ))}
            </ul>
          )}
        </DropdownText>
      </li>
    ))
  }
</ol>
