---
// Pie del sitio. Es de Layout.astro, no de la lista de secciones, asi que lo
// comparten todos los diseños: por eso su color sale de los tokens.
const currentYear = new Date().getFullYear();
interface Props {
  footerInfor: any;
}
const { footerInfor } = Astro.props;
---

<footer
  class="shadow m-4 p-2 bg-[var(--dis-superficie-suave)] backdrop-blur-lg w-full mx-auto container lg:max-w-4xl md:max-w-2xl mb-5 flex justify-center"
  style="border-radius: var(--dis-radio); box-shadow: var(--dis-sombra);"
>
  <div
    class="w-full max-w-screen-xl mx-auto md:flex md:items-center md:justify-between"
  >
    <span class="text-sm sm:text-center text-[var(--dis-texto-suave)]"
      >© {currentYear}
      <a href={footerInfor.url} class="hover:underline">{footerInfor.name}</a>.
      <a href={footerInfor.urlMencion} class="pl-2 hover:underline"
        >{footerInfor.mencion}</a
      >
    </span>
    <ul
      class="flex flex-wrap items-center mt-3 text-sm font-medium text-[var(--dis-texto-suave)] sm:mt-0"
    >
      <li>
        <a href={footerInfor.itemInfo.url} class="hover:underline me-4 md:me-6"
          >{footerInfor.itemInfo.title}</a
        >
      </li>
      <li>
        <a
          id={footerInfor.itemcontact.label}
          href={footerInfor.itemcontact.url}
          class="hover:underline me-4 md:me-3"
          >{footerInfor.itemcontact.title}</a
        >
      </li>
    </ul>
  </div>
</footer>
