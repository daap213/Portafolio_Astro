---
// Cita del diseño "editorial": un destacado tipografico, centrado y con la
// imagen reducida a una firma redonda al pie.
interface Props {
  infoSeccion: any;
}
const { infoSeccion } = Astro.props;
---

<figure class="max-w-2xl mx-auto text-center">
  <blockquote
    class="text-2xl sm:text-3xl leading-snug text-[var(--dis-texto)] [&>strong]:text-[var(--dis-acento)] [&>strong]:font-normal"
    style="font-family: var(--dis-fuente-titulos)"
  >
    <span class="text-[var(--dis-acento)]">&ldquo;</span>{infoSeccion.frase}<span
      class="text-[var(--dis-acento)]">&rdquo;</span
    >
  </blockquote>

  <figcaption class="flex items-center justify-center gap-3 mt-8">
    <img
      src={infoSeccion.logo}
      alt={infoSeccion.name}
      class="object-cover rounded-full size-10 grayscale"
      style="object-position: 100% 60%"
    />
    <span
      class="text-xs uppercase tracking-[0.2em] text-[var(--dis-texto-suave)]"
    >
      {infoSeccion.name}
    </span>
  </figcaption>
</figure>
