---
import SunIcon from "@/components/icons/Sun.astro";
import MoonIcon from "@/components/icons/Moon.astro";
import SystemIcon from "@/components/icons/System.astro";
interface Props {
  ui: any;
}
const { ui } = Astro.props;

// El valor guardado en localStorage viaja en data-tema, NO en el texto visible:
// antes se leia de innerText y traducir estas etiquetas rompia el tema en silencio.
const TEMAS = [
  { valor: "light", etiqueta: ui.tema_claro },
  { valor: "dark", etiqueta: ui.tema_oscuro },
  { valor: "system", etiqueta: ui.tema_sistema },
];
---

<div class="relative mx-1">
  <button
    id="theme-toggle-btn"
    class="relative inline-flex h-5 w-5 items-center justify-center appearance-none border-none hover:scale-125 transition"
  >
    <span class="sr-only">{ui.ThemeToggle_title}</span>
    <SunIcon
      id="light"
      class="theme-toggle-icon absolute inset-0 size-5 transition-all"
    />
    <MoonIcon
      id="dark"
      class="theme-toggle-icon absolute inset-0 size-5 transition-all"
    />
    <SystemIcon
      id="system"
      class="theme-toggle-icon absolute inset-0 size-5 transition-all"
    />
  </button>
  <div
    id="themes-menu"
    class="absolute opacity-0 scale-80 top-8 right-0 text-sm p-1 min-w-[8rem] rounded-md border border-gray-100 bg-white/70 dark:bg-gray-900/70 dark:border-gray-500/20 shadow-[0_3px_10px_rgb(0,0,0,0.2)] backdrop-blur-md"
  >
    <ul>
      {
        TEMAS.map((tema) => (
          <li
            class="themes-menu-option px-2 py-1.5 cursor-pointer hover:bg-neutral-400/40 dark:hover:bg-gray-500/50 rounded-sm"
            data-tema={tema.valor}
          >
            {tema.etiqueta}
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  #themes-menu.open {
    animation: scale-up-center 0.15s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
    display: block !important;
  }
  #themes-menu {
    display: none !important;
  }

  @keyframes scale-up-center {
    from {
      transform: scale(0.8);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }
</style>

<script is:inline>
  // Este script NO decide el tema: eso lo hace el <head> de Layout.astro antes
  // del primer pintado, y expone `window.aplicarTema()`. Aqui solo esta el
  // menu: abrirlo, guardar la eleccion y marcar el icono activo. Tener la
  // logica en un solo sitio evita que las dos copias se separen.
  const initializeThemeToggle = () => {
    const toggleButton = document.getElementById("theme-toggle-btn");
    const themesMenu = document.getElementById("themes-menu");

    if (
      !toggleButton ||
      !themesMenu ||
      toggleButton.dataset.themeReady === "true"
    ) {
      return;
    }

    toggleButton.dataset.themeReady = "true";

    // Reserva por si el selector se usa fuera de Layout.astro: al menos guarda
    // la preferencia y pinta el icono, aunque no aplique la clase
    const aplicarTema = () => {
      if (typeof window.aplicarTema === "function") return window.aplicarTema();
      try {
        return localStorage.getItem("theme") ?? "system";
      } catch {
        return "system";
      }
    };

    const updateIcon = (themePreference) => {
      document.querySelectorAll(".theme-toggle-icon").forEach((element) => {
        const isActive = element.id === themePreference;
        element.style.transform = isActive ? "scale(1)" : "scale(0)";
        element.style.opacity = isActive ? "1" : "0";
      });
    };

    toggleButton.addEventListener("click", (e) => {
      e.stopPropagation();
      const isClosed = !themesMenu.classList.contains("open");
      themesMenu.classList[isClosed ? "add" : "remove"]("open");
    });
    document.querySelectorAll(".themes-menu-option").forEach((element) => {
      element.addEventListener("click", () => {
        // El valor viene de data-tema, no del texto: asi se puede traducir
        localStorage.setItem("theme", element.dataset.tema);
        updateIcon(aplicarTema());
      });
    });
    document.addEventListener("click", () =>
      themesMenu.classList.remove("open"),
    );

    // Con "system", el icono tambien tiene que seguir al sistema si cambia
    window
      .matchMedia("(prefers-color-scheme: dark)")
      .addEventListener("change", () => updateIcon(aplicarTema()));

    updateIcon(aplicarTema());
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeThemeToggle, {
      once: true,
    });
  } else {
    initializeThemeToggle();
  }

  document.addEventListener("astro:page-load", initializeThemeToggle);
</script>
