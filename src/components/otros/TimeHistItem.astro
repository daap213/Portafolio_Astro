---
// Entrada de una cronologia: viñeta, titulo, empresa, valoracion y fecha.
//
// Los colores salen de los tokens del diseño activo, no de utilidades fijas:
// este componente lo comparten la experiencia, la educacion y los certificados,
// asi que es el que hace que un diseño se note aunque no traiga variante propia
// para esas secciones.
//
// Consolidacion deliberada al tokenizar: la viñeta usaba `yellow-400` y el
// titulo `yellow-500`, dos amarillos vecinos para el mismo papel; ahora los dos
// son `--dis-acento`. Lo mismo con la linea de la izquierda, que combinaba
// `black/20` y `white/15` y ahora es `--dis-borde`.
interface Props {
  title: string;
  company?: string;
  date?: string;
  appreciation?: string;
  extraclass?: string;
}
const {
  title,
  company,
  date,
  appreciation,
  extraclass = "md:col-span-2",
} = Astro.props;
---

<div
  class="relative mx-12 pb-3 grid before:absolute before:left-[-35px] before:block before:h-full before:border-l-2 before:border-[var(--dis-borde)] before:content-[''] md:grid-cols-5 md:gap-10 md:space-x-4]"
>
  <div class={`relative pb-12 ${extraclass}`}>
    <div class="sticky top-0">
      <span
        class="text-[var(--dis-acento)] -left-[42px] absolute rounded-full text-5xl"
        >&bull;</span
      ><h3 class="text-xl font-bold text-[var(--dis-acento)]">{title}</h3>
      {
        company && (
          <h4 class="font-semibold text-lg text-[var(--dis-texto-suave)]">
            {company}
          </h4>
        )
      }
      {
        appreciation && (
          <span class="inline-block mt-1 text-xs font-medium px-2 py-0.5 rounded-full text-[var(--dis-acento)] border border-[var(--dis-borde)]">
            {appreciation}
          </span>
        )
      }
      {
        date && (
          <time class="p-0 m-0 text-sm text-[var(--dis-texto-suave)]">
            {date}
          </time>
        )
      }
    </div>
  </div>
  <slot />
</div>
