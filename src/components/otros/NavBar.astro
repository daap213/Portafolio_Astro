---
import ThemeToggle from "@/components/otros/ThemeToggle.astro";
interface Props {
  navItems: any;
  /** Los DEMAS idiomas: [{ codigo, etiqueta, ruta }]. Ya no se supone que haya solo dos. */
  idiomas: { codigo: string; etiqueta: string; ruta: string }[];
  ui: any;
}
const { navItems, idiomas, ui } = Astro.props;
---

<header
  class="fixed top-0 z-10 flex items-center justify-end md:justify-center w-full mx-auto mt-2"
>
  <!-- Navbar -->
  <nav
    id="navbar"
    class="hidden menu grid-hidden md:flex md:flex-wrap px-3 text-sm font-medium md:rounded-full rounded-lg text-[var(--dis-texto-suave)] justify-center items-center"
  >
    {
      navItems.map((link: Props["navItems"]) => (
        <a
          class={`px-2 py-2 md:px-4 md:py-2  md:ml-0 transition hover:text-[var(--dis-acento)]`}
          aria-label={link.label}
          href={link.url}
        >
          {link.title}
        </a>
      ))
    }
    <a class="px-2 py-2 md:px-4 md:py-2 ml-2 md:ml-0"><ThemeToggle ui={ui} /></a
    >
    {
      idiomas.map((idioma) => (
        <a
          href={idioma.ruta}
          class="px-2 py-2 md:px-4 md:py-2 ml-2 md:ml-0 transition hover:text-yellow-500 dark:hover:text-yellow-400"
        >
          {idioma.etiqueta}
        </a>
      ))
    }
  </nav>
  <!-- Botón para mostrar/ocultar el navbar en pantallas pequeñas -->
  <button
    id="toggleButton"
    class="block md:hidden rounded-full px-4 py-2 text-[var(--dis-texto-suave)] hover:text-[var(--dis-texto)] transition"
  >
    <!-- Ícono de menú (puedes cambiarlo según tu preferencia) -->
    <svg
      class="w-8 h-8"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M4 6h16M4 12h16m-7 6h7"></path>
    </svg>
  </button>
</header>

<script>
  const initializeNavbar = () => {
    const navbar = document.getElementById("navbar");
    const toggleButton = document.getElementById("toggleButton");

    if (!navbar || !toggleButton || navbar.dataset.navReady === "true") {
      return;
    }

    navbar.dataset.navReady = "true";

    const menuLinks = document.querySelectorAll(".menu a[href^='#']");
    const sections = Array.from(menuLinks)
      .map((menuLink) => {
        const hash = menuLink.getAttribute("href") ?? "";
        const section = hash ? document.querySelector(hash) : null;
        return {
          link: menuLink,
          section,
        };
      })
      .filter(({ section }) => section != null);

    // El enlace activo se marca con una clase propia, no con utilidades de
    // color: el color lo pone --dis-acento, que cambia con el diseño. Con
    // `text-yellow-500` escrito aquí, cambiar de diseño dejaba la marca amarilla
    // sobre cualquier paleta, y además esas clases solo existían en el CSS
    // porque este script las menciona.
    const clearActiveLinks = () => {
      menuLinks.forEach((menuLink) => {
        menuLink.classList.remove("nav-activo");
      });
    };

    const updateActiveLink = () => {
      if (sections.length === 0) {
        return;
      }

      const activationLine = window.innerHeight * 0.35;
      let activeItem = sections[0];

      sections.forEach((item) => {
        if (!item.section) {
          return;
        }
        const top = item.section.getBoundingClientRect().top;
        if (top <= activationLine) {
          activeItem = item;
        }
      });

      clearActiveLinks();
      activeItem.link.classList.add("nav-activo");
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) {
        return;
      }
      ticking = true;
      requestAnimationFrame(() => {
        updateActiveLink();
        ticking = false;
      });
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    updateActiveLink();

    // Función para alternar la visibilidad del navbar
    function toggleNavbar() {
      navbar?.classList.toggle("grid-hidden");
      toggleButton?.classList.toggle("open");
    }

    // Escuchar el clic en el botón de alternancia
    toggleButton?.addEventListener("click", toggleNavbar);

    menuLinks.forEach((menuLink) => {
      menuLink.addEventListener("click", () => {
        navbar.classList.add("grid-hidden");
        toggleButton.classList.remove("open");
      });
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeNavbar, {
      once: true,
    });
  } else {
    initializeNavbar();
  }

  document.addEventListener("astro:page-load", initializeNavbar);
</script>

<style>
  nav {
    animation: nav-shadown 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  /* Enlace de la sección que se está mirando. La pone y la quita el script de
     abajo. El color sale del diseño activo, así que sigue a la paleta en vez de
     estar clavado en amarillo. */
  .nav-activo {
    color: var(--dis-acento);
  }

  button {
    animation: nav-shadown 1s linear both;
  }

  /* El color lo pone --nav-desenfoque-fondo, que Layout.astro define para cada
     tema (aqui no valdria: este <style> es scoped y `.dark` se convertiria en
     `.dark[data-astro-cid-...]`, que no casa con el <html>).

     Antes esto se redefinia entero dentro de @media (prefers-color-scheme:
     dark) declarando solo `background-color`, y como redefinir unos @keyframes
     los REEMPLAZA, en modo oscuro la barra perdia la sombra, el desenfoque y el
     contorno. */
  @keyframes nav-shadown {
    to {
      box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
      backdrop-filter: blur(8px);
      background-color: var(--nav-desenfoque-fondo);
      outline: 1px solid rgb(255 255 255 / 0.1);
    }
  }

  /* Estilos para pantallas pequeñas */
  @media (max-width: 767px) {
    .menu {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
    }
    .grid-hidden {
      display: none;
    }
    /* Estilo adicional para el botón de alternancia abierto en pantallas pequeñas */
    #toggleButton.open svg {
      transform: rotate(90deg);
    }
  }
</style>
