---
// Vista previa de un diseño SIN activarlo. Solo existe en `astro dev`.
//
// Es la pantalla de comparación del administrador: /vista/<diseno>/<idioma>.
//
// `getStaticPaths` devuelve [] fuera de desarrollo, así que el build no genera
// ni una sola de estas páginas y no se publica nada. La aserción de
// dist.test.js que enumera las páginas esperadas es justo la que lo vigila.
//
// Por qué una ruta y no `?diseno=`: en una página prerenderizada Astro descarta
// la cadena de consulta —también en desarrollo—, así que `Astro.url` llega sin
// parámetros y no hay nada que leer.
//
// El conmutador de idioma SÍ se queda dentro de la vista previa: Portada.astro
// reescribe sus enlaces a /vista/<diseno>/<idioma>. Sin eso, cambiar de idioma
// devolvía al diseño activo y parecía que la comparación se hubiera perdido.
// Lo que sí sale de aquí es cualquier otro enlace (los PDF, el pie): apuntan al
// sitio de verdad.
import Portada from "@/components/otros/Portada.astro";
import { CODIGOS } from "@cv/locales";
import catalogo from "@cv/data/disenos.json";

export function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  return catalogo.disenos.flatMap((diseno) =>
    CODIGOS.map((lang) => ({ params: { diseno: diseno.id, lang } })),
  );
}

const { diseno, lang } = Astro.params;
---

<Portada lang={lang!} diseno={diseno} />
