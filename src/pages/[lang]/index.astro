---
// Portada de cualquier idioma declarado en data/locales.json.
// Sustituye a las copias es/index.astro y en/index.astro: dar de alta un idioma
// ya no crea ficheros, solo datos.
//
// El cuerpo vive en Portada.astro, compartido con la raiz del sitio.
import Portada from "@/components/otros/Portada.astro";
import { CODIGOS } from "@cv/locales";

export function getStaticPaths() {
  return CODIGOS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
---

<Portada lang={lang} />
