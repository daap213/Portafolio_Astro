---
import "@fontsource-variable/onest";
import "@/styles/global.css";
import Header from "@/components/otros/NavBar.astro";
import Footer from "@/components/seccions/Footer.astro";
import { raizApp } from "@cv/cv";

const { currentLocale } = Astro;

interface Props {
  title: string;
  description: string;
  navItems: any;
  footerInfor: any;
  /** Los demas idiomas disponibles: [{ codigo, etiqueta, ruta }] */
  idiomas: { codigo: string; etiqueta: string; ruta: string }[];
  ui: any;
}

const { description, title, navItems, footerInfor, idiomas, ui } = Astro.props;
---

<!doctype html>
<html lang={currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={raizApp + "img/logo.webp"} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    {/*
      El tema se decide AQUI, en el <head> y sin `defer`, para que la clase
      `.dark` este puesta antes del primer pintado. Estaba en el <script> del
      selector, que vive en el <body> y ademas esperaba a DOMContentLoaded: la
      pagina pintaba siempre en claro y se corregia despues, o sea un fogonazo
      blanco en cada carga para quien usa el modo oscuro.

      Es el UNICO sitio que aplica el tema. ThemeToggle.astro solo guarda la
      preferencia y llama a `aplicarTema()`, para que no haya dos copias de esta
      logica que puedan separarse.
    */}
    <script is:inline>
      (() => {
        const consulta = window.matchMedia("(prefers-color-scheme: dark)");

        const preferencia = () => {
          try {
            return localStorage.getItem("theme") ?? "system";
          } catch {
            // Sin localStorage (modo privado con cookies bloqueadas) se sigue al sistema
            return "system";
          }
        };

        // Devuelve la preferencia guardada para que el selector pinte su icono
        window.aplicarTema = () => {
          const tema = preferencia();
          const esOscuro = tema === "dark" || (tema === "system" && consulta.matches);
          document.documentElement.classList.toggle("dark", esOscuro);
          return tema;
        };

        // Con "system" hay que seguir al sistema aunque cambie con la pagina abierta
        consulta.addEventListener("change", () => window.aplicarTema());

        window.aplicarTema();
      })();
    </script>
  </head>

  <body class="relative text-black dark:text-white">
    <div
      class="absolute top-0 bottom-0 z-[-2] min-h-screen w-full bg-gray-50 dark:bg-gray-950
      bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(217,216,255,0.5),rgba(255,255,255,0.9))]
      dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"
    >
    </div>
    <Header navItems={navItems} idiomas={idiomas} ui={ui} />
    <slot />
    <Footer footerInfor={footerInfor} />
    <style is:global>
      /* Sigue al interruptor, no al sistema: con `color-scheme: light dark`
         fijo, elegir "Claro" en un sistema oscuro dejaba las barras de
         desplazamiento y los controles nativos en oscuro (y al reves). */
      :root {
        color-scheme: light;
      }
      :root.dark {
        color-scheme: dark;
      }

      /* Lo unico que cambia entre temas en las animaciones de la barra.
         Van aqui, en un ambito global, porque el <style> de NavBar.astro es
         scoped: alli Astro convertiria `.dark` en `.dark[data-astro-cid-...]`,
         que nunca casa con el <html class="dark">. Las variables si se heredan
         hacia dentro de los estilos scoped. */
      :root {
        --nav-fondo: rgb(229, 229, 229);
        --nav-desenfoque-fondo: rgb(209 213 219 / 0.6);
        --nav-sombra: 0px 5px 50px -5px rgba(0, 0, 0, 0.1), 0px 0px 0 1px rgba(0, 0, 0, 0.3);
      }
      :root.dark {
        --nav-fondo: rgba(0, 0, 0, 0.3);
        --nav-desenfoque-fondo: rgb(31 41 55 / 0.6);
        --nav-sombra: 0px 5px 50px -5px rgba(0, 0, 0, 0.4), 0px 0px 0 1px rgba(0, 0, 0, 0.5);
      }

      html {
        font-family: "Onest Variable", system-ui, sans-serif;
        scroll-behavior: smooth;
      }

      /* El color del texto lo ponen las utilidades `text-black dark:text-white`
         del <body>: una regla de elemento aqui pierde por especificidad y solo
         serviria para confundir. */
      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        overscroll-behavior: none;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }

      #header-nav {
        animation: blur linear both 0.5s;
        animation-timeline: scroll();
        animation-range: 0 500px;
      }

      /* UNA sola declaracion: lo que cambia entre temas sale por variables.
         Antes habia una segunda dentro de @media (prefers-color-scheme: dark),
         que seguia al sistema y no al interruptor. No se puede acotar unos
         @keyframes con `.dark`: solo los reemplaza otra declaracion del mismo
         nombre, asi que la unica salida es parametrizarlos. */
      @keyframes blur {
        from {
          border: 0px;
        }
        to {
          box-shadow: var(--nav-sombra);
          backdrop-filter: blur(20px);
          border-width: 1px;
          border-color: rgba(0, 0, 0);
          padding: 0.25rem 0.75rem;
          display: flex;
          flex-direction: row;
          align-items: center;
          background-color: var(--nav-fondo);
          border-radius: 9999px;
        }
      }
    </style>
  </body>
</html>
